    {
        "id": "4ca55cbd8d831c0f",
        "type": "function",
        "z": "63a89909ee927b5c",
        "name": "Map status to UI",
        "func": "const p = msg.payload || {};\nconst outState = { payload: p.gameState ?? '—' };\nconst outTop   = { payload: p.topScore ?? 0 };\nconst outLevel = { payload: p.currentLevel ?? 0 };\nconst outRun   = { payload: (p.runActive ? 'true' : 'false') };\nconst outSeq   = { payload: p.currentSequence ?? '' };\nconst outDiff  = { payload: p.difficulty ?? '—' };\nconst maxSeq = p.maxSeq ?? 255;\nconst outLevelGauge = { payload: p.currentLevel ?? 0, ui_control: { max: maxSeq } };\nconst outTopGauge   = { payload: p.topScore ?? 0, ui_control: { max: maxSeq } };\nreturn [outState, outTop, outLevel, outRun, outSeq, outDiff, outLevelGauge, outTopGauge];",
        "outputs": 8,
        "x": 680,
        "y": 120,
        "wires": [
            [
                "60c7db5d297ffbd4"
            ],
            [
                "ef5995c1a8061254"
