        "type": "function",
        "z": "63a89909ee927b5c",
        "name": "Runs -> table",
        "func": "const p = msg.payload || {};\nconst runs = p.runs || [];\nmsg.payload = runs.map(r => ({\n  score: r.score,\n  time: r.time,\n  difficulty: r.difficulty ?? '—',\n  sequence: r.sequence\n}));\nreturn msg;",
        "outputs": 1,
        "x": 680,
        "y": 220,
        "wires": [
            [
                "b65842363505b0cd"
            ]
        ]
